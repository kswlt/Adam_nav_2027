+++ b/src/small_point_lio/dense_projection.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include "eskf.h"
+#include <stdexcept>
+
+namespace small_point_lio {
+
+// Same local constant velocity/angular-rate model as eskf::predict_state.
+// This is publication-only projection to a real point time, not a filter update.
+inline Eigen::Matrix<state::value_type, 3, 1> project_dense_point(
+    const state & source, const Eigen::Matrix<state::value_type, 3, 1> & point_imu,
+    double elapsed_seconds) {
+    if (!std::isfinite(elapsed_seconds) || elapsed_seconds < 0.) {
+        throw std::invalid_argument("Dense point precedes filter time or has invalid time");
+    }
+    const auto dt = static_cast<state::value_type>(elapsed_seconds);
+    return source.position + source.velocity * dt +
+        source.rotation * exp<state::value_type>((source.omg * dt).eval()) * point_imu;
+}
+
+}  // namespace small_point_lio
