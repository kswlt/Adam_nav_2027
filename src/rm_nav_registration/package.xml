<?xml version="1.0"?>
<package format="3">
  <name>rm_nav_registration</name>
  <version>0.1.0</version>
  <description>Unified small_gicp and KISS registration adapters.</description>
  <maintainer email="nav@kswlt.dev">RM Nav Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>small_gicp</depend>
  <!-- KISS/ROBIN are user-space CMake dependencies installed by the bootstrap script. -->
  <depend>kiss_matcher</depend>
  <depend>libtbb-dev</depend>
  <depend>libflann-dev</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
